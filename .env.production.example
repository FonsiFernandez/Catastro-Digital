# Catastro Digital — production environment template
#
# Copy this file to .env.production on the production server:
#   cp .env.production.example .env.production
#
# NEVER commit .env.production.

# Public hostname only. Do not include https:// or a trailing slash.
DOMAIN=catastro.example.com

# PostgreSQL / PostGIS
POSTGRES_DB=catastro
POSTGRES_USER=catastro

# Generate a long random value before deployment.
# Recommended command:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=CHANGE_ME

# Generate another independent random value.
# Recommended command:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME

NEXT_PUBLIC_USE_MOCK_CADASTRE=false